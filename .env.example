# ContextHub server
DATABASE_URL=postgresql://contexthub:contexthub@localhost:5432/contexthub
API_KEY=changeme

# Model provider: OpenAI or an OpenAI-compatible endpoint
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
# Optional: disable thinking only if the endpoint supports this parameter.
# CHAT_ENABLE_THINKING=false
EMBEDDING_MODEL=text-embedding-3-small
# Requested API output dimension; responses must match exactly.
EMBEDDING_DIMENSIONS=1536

# keyword: BM25 rerank; none: keep vector scores (other search policies still apply).
# by_type: table_schema-only searches use vector scores; other searches use BM25.
RERANK_STRATEGY=keyword
